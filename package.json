{
  "name": "kept",
  "version": "0.1.0",
  "description": "Pay-on-proof infrastructure for AI agents, built on PayPal",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed.ts",
    "doctor": "tsx scripts/doctor.ts",
    "spike:token": "tsx scripts/spike-token.ts",
    "demo:verify": "tsx scripts/demo-verify.ts"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@onkernel/sdk": "^0.144.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
