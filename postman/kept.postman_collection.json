tems\": [\n          {\n            \"description\": \"Contact form sends a message and confirms it\",\n            \"check_type\": \"form_submits\",\n            \"params\": {\n              \"path\": \"/contact.html\",\n              \"form_selector\": \"#contact-form\",\n              \"fields\": {\n                \"#name\": \"Kept Verifier\",\n                \"#email\": \"verifier@example.com\",\n                \"#message\": \"Hello from the Kept verifier.\"\n              },\n              \"success\": {\n                \"text\": \"Thanks \\u2014 we'll be in touch\"\n              }\n            }\n          }\n        ]\n      },\n      {\n        \"title\": \"Mobile ready and fast\",\n        \"amount_cents\": 2500,\n        \"items\": [\n          {\n            \"description\": \"No sideways scrolling on a phone\",\n            \"check_type\": \"mobile_no_overflow\",\n            \"params\": {\n              \"path\": \"/\"\n            }\n          },\n          {\n            \"description\": \"Home page loads in under 3 seconds\",\n            \"check_type\": \"load_time_under\",\n            \"params\": {\n              \"path\": \"/\",\n              \"ms\": 3000\n            }\n          }\n        ]\n      }\n    ]\n  }\n}"
