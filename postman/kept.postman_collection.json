{
  "info": {
    "name": "Kept \u2014 Proof-Carrying Payments",
    "description": "Kept's REST API (job lifecycle, proof, judge mode, MCP) and the raw PayPal sandbox calls Kept makes. Run the 'Job lifecycle' folder top to bottom. Set clientToken / workerToken from `npm run party-token -- party_demo_client` (or use Judge mode: demo session). No secrets are stored in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Job lifecycle",
      "item": [
        {
          "name": "Post a job (client)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs"
              ]
            },
            "description": "The client posts a job with its contract. The server adds its verifier quorum. Saves jobId and checklistHash.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Halcyon Crumb website\",\n  \"brief\": \"A bakery website with a menu and a working contact form.\",\n  \"worker_id\": \"party_demo_worker\",\n  \"budget_cents\": 10000,\n  \"checklist\": {\n    \"version\": 1,\n    \"currency\": \"USD\",\n    \"total_cents\": 10000,\n    \"milestones\": [\n      {\n        \"title\": \"Home page live\",\n        \"amount_cents\": 2500,\n        \"items\": [\n          {\n            \"description\": \"Home page loads\",\n            \"check_type\": \"http_status\",\n            \"params\": {\n              \"path\": \"/\",\n              \"expected\": 200\n            }\n          },\n          {\n            \"description\": \"Shows the tagline\",\n            \"check_type\": \"text_present\",\n            \"params\": {\n              \"path\": \"/\",\n              \"text\": \"Slow bread, baked before sunrise.\"\n            }\n          },\n          {\n            \"description\": \"Navigation links to the menu\",\n            \"check_type\": \"element_exists\",\n            \"params\": {\n              \"path\": \"/\",\n              \"selector\": \"nav a[href='menu.html']\"\n            }\n          }\n        ]\n      },\n      {\n        \"title\": \"Menu published\",\n        \"amount_cents\": 2500,\n        \"items\": [\n          {\n            \"description\": \"Menu lists items\",\n            \"check_type\": \"element_exists\",\n            \"params\": {\n              \"path\": \"/menu.html\",\n              \"selector\": \".menu-item\"\n            }\n          },\n          {\n            \"description\": \"Menu includes the sourdough loaf\",\n            \"check_type\": \"text_present\",\n            \"params\": {\n              \"path\": \"/menu.html\",\n              \"text\": \"Country sourdough loaf\"\n            }\n          },\n          {\n            \"description\": \"No broken links on the home page\",\n            \"check_type\": \"links_ok\",\n            \"params\": {\n              \"path\": \"/\"\n            }\n          }\n        ]\n      },\n      {\n        \"title\": \"Contact form works\",\n        \"amount_cents\": 2500,\n        \"items\": [\n          {\n            \"description\": \"Contact form sends a message and confirms it\",\n            \"check_type\": \"form_submits\",\n            \"params\": {\n              \"path\": \"/contact.html\",\n              \"form_selector\": \"#contact-form\",\n              \"fields\": {\n                \"#name\": \"Kept Verifier\",\n                \"#email\": \"verifier@example.com\",\n                \"#message\": \"Hello from the Kept verifier.\"\n              },\n              \"success\": {\n                \"text\": \"Thanks \\u2014 we'll be in touch\"\n              }\n            }\n          }\n        ]\n      },\n      {\n        \"title\": \"Mobile ready and fast\",\n        \"amount_cents\": 2500,\n        \"items\": [\n          {\n            \"description\": \"No sideways scrolling on a phone\",\n            \"check_type\": \"mobile_no_overflow\",\n            \"params\": {\n              \"path\": \"/\"\n            }\n          },\n          {\n            \"description\": \"Home page loads in under 3 seconds\",\n            \"check_type\": \"load_time_under\",\n            \"params\": {\n              \"path\": \"/\",\n              \"ms\": 3000\n            }\n          }\n        ]\n      }\n    ]\n  }\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('jobId', j.id);",
                  "pm.collectionVariables.set('checklistHash', j.checklist_hash);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get job",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}"
              ]
            },
            "description": "Full state: checklist + hash, acceptances, milestones and verdicts, PayPal IDs, verification round. Public.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Accept contract (client)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}",
                "accept"
              ]
            },
            "description": "Accept exactly the reviewed hash.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checklist_hash\": \"{{checklistHash}}\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Accept contract (worker)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}",
                "accept"
              ]
            },
            "description": "When both parties have accepted the same hash, the contract is frozen (AGREED).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checklist_hash\": \"{{checklistHash}}\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{workerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('agreed', () => pm.expect(pm.response.json().agreed).to.eql(true));"
                ]
              }
            }
          ]
        },
