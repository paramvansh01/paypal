            "url": {
              "raw": "{{paypalBaseUrl}}/v1/oauth2/token",
              "host": [
                "{{paypalBaseUrl}}"
              ],
              "path": [
                "v1",
                "oauth2",
                "token"
              ]
            },
            "description": "Basic auth with client ID and secret; body grant_type=client_credentials. Saves paypalToken.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{paypalClientId}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{paypalClientSecret}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
