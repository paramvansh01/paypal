# Copy this file to .env and fill in the values. Never commit .env.
# Run `npm run doctor` afterwards to check every key and service.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
# REST app of the Platform / Marketplace type.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox only. Never point this at the live API.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Partner BN code, sent as PayPal-Partner-Attribution-Id (delayed_disbursement rail only).
PAYPAL_PARTNER_ATTRIBUTION_ID=
# Our partner (platform) merchant ID (delayed_disbursement rail only).
PAYPAL_PARTNER_MERCHANT_ID=
# Webhook ID from the dashboard. Only needed on the hosted deployment.
PAYPAL_WEBHOOK_ID=
# Which money path to use: delayed_disbursement or auth_capture.
PAYMENT_RAIL=delayed_disbursement

# --- Demo parties (sandbox accounts from developer.paypal.com > Sandbox accounts) ---
# Personal sandbox account that pays (the client / buyer).
DEMO_CLIENT_EMAIL=
# Business sandbox account that gets paid (the worker / seller).
DEMO_WORKER_EMAIL=
DEMO_WORKER_MERCHANT_ID=

# --- AI ---
ANTHROPIC_API_KEY=
# Anthropic model ID used for checklist generation and judgement (current Opus as of 2026-11-10).
LLM_MODEL=claude-opus-5-5

# --- Verifier quorum ---
# Browser for verifier-a: kernel = KERNEL cloud browser (needs KERNEL_API_KEY); local = Chromium on this machine.
# verifier-b always uses local Chromium and verifier-c local WebKit.
VERIFIER_BROWSER=kernel
KERNEL_API_KEY=
# Number of verifiers (n) and how many must agree (k). k must be more than half of n.
QUORUM_N=3
QUORUM_K=2
# Where each verifier's Ed25519 signing key is kept. Created automatically on first run. Keep it private.
VERIFIER_KEYS_DIR=./data/keys
# Optional, for hosts without a persistent disk: {"verifier-a": {<private JWK>}, ...}. Overrides the dir.
VERIFIER_KEYS_JSON=
# AI judge model for each verifier, in order (a, b, c). Different models reduce single-model bias.
JUDGE_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5

# --- App ---
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/kept.db
# Bearer token that MCP clients must send to /mcp. Any long random string.
MCP_AUTH_TOKEN=
